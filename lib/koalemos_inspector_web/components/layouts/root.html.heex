<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Koalemos Inspector">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/wireframe_editor.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/wireframe_editor.js"}>
    </script>
  </head>
  <body class="bg-slate-900 text-white">
    {@inner_content}
  </body>
</html>
