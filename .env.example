# Koalemos Environment Configuration Example
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Provider Selection (choose one: anthropic, openai, ollama)
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic Claude Configuration
# -----------------------------------------------------------------------------
# Get API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Available models:
# - claude-sonnet-4-5 (recommended - best balance)
# - claude-opus-4 (most capable, slower)
# - claude-haiku-4-5 (fastest, cheapest)

# -----------------------------------------------------------------------------
# OpenAI Configuration
# -----------------------------------------------------------------------------
# Get API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Available models:
# - gpt-4o (recommended)
# - gpt-4-turbo
# - gpt-3.5-turbo (cheapest)

# -----------------------------------------------------------------------------
# Ollama Configuration (Local Models)
# -----------------------------------------------------------------------------
# Ollama base URL
# - If Ollama runs on host: http://host.docker.internal:11434
# - If Ollama runs in Docker: http://ollama:11434
# - If not using Docker: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Recommended models (pull with: ollama pull <model>):
# - qwen2.5:7b (best overall)
# - llama3.2:3b (smaller, faster)
# - mistral:7b (good alternative)

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run Phoenix server on
PORT=4000

# Start Phoenix server automatically (true/false)
PHX_SERVER=true

# Secret key base for session encryption
# Generate with: mix phx.gen.secret
# Leave empty to auto-generate (ephemeral, for dev/demo only)
SECRET_KEY_BASE=

# =============================================================================
# Development/Debug Configuration (Optional)
# =============================================================================

# Mix environment (dev, test, prod)
# MIX_ENV=prod

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# Enable debug mode
# DEBUG=false
